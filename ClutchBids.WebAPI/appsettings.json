{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": false,
      "Path": "Logs/app.log"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ClutchBidsDb;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-change-in-production",
    "Issuer": "clutchbids-api",
    "Audience": "clutchbids-app",
    "ExpirationMinutes": 60
  },
  "FileSettings": {
    "IdDocumentsPath": "wwwroot/uploads/id-documents",
    "CarPapersPath": "wwwroot/uploads/car-papers",
    "CarImagesPath": "wwwroot/uploads/car-images",
    "CarVideosPath": "wwwroot/uploads/car-videos",
    "MaxFileSize": 10485760,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedVideoExtensions": [ ".mp4", ".avi", ".mov" ],
    "AllowedDocumentExtensions": [ ".pdf", ".jpg", ".jpeg", ".png" ]
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "noreply@clutchbids.com",
    "SenderName": "ClutchBids",
    "EnableSSL": true
  },
  "AppSettings": {
    "AppName": "ClutchBids",
    "AppVersion": "1.0.0",
    "SupportEmail": "support@clutchbids.com"
  }
}
